{
  // Workers로 배포할 때 쓰는 설정. 시크릿은 여기 적지 말고 대시보드나 `npx wrangler secret put`으로.
  "name": "manhwa",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // 대시보드에서 넣은 변수를 배포 때 지우지 않게
  "keep_vars": true
}
